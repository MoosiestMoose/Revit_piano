    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference(\"ProtoGeometry\")\r\nfrom Autodesk.DesignScript.Geometry import *\r\nclr.AddReference(\"System.Windows.Forms\")\r\nfrom System.Windows.Forms import Cursor\r\n\r\n# Get cuboids from Dynamo input\r\ncuboids = IN[0]\r\n\r\n# Function to calculate centroid from Bounding Box\r\ndef get_centroid(cuboid):\r\n    bbox = cuboid.BoundingBox\r\n    min_pt = bbox.MinPoint\r\n    max_pt = bbox.MaxPoint\r\n    centroid_x = (min_pt.X + max_pt.X) / 2\r\n    centroid_y = (min_pt.Y + max_pt.Y) / 2\r\n    centroid_z = (min_pt.Z + max_pt.Z) / 2\r\n    return Point.ByCoordinates(centroid_x, centroid_y, centroid_z)\r\n\r\n# Extract centroids\r\ncuboid_centroids = [get_centroid(c) for c in cuboids]\r\n\r\n# Get mouse screen position\r\nmouse_pos = Cursor.Position\r\nmouse_x, mouse_y = mouse_pos.X, mouse_pos.Y\r\n\r\n# Function to approximate screen to Dynamo space (Assumes uniform scaling)\r\ndef screen_to_dynamo(x, y, screen_width=1920, screen_height=1080, dynamo_width=100, dynamo_height=100):\r\n    dynamo_x = (x / screen_width) * dynamo_width\r\n    dynamo_y = ((screen_height - y) / screen_height) * dynamo_height  # Invert Y\r\n    return dynamo_x, dynamo_y\r\n\r\n# Convert screen position to estimated Dynamo space\r\ndyn_x, dyn_y = screen_to_dynamo(mouse_x, mouse_y)\r\n\r\n# Find the closest cuboid based on 2D distance (X and Y)\r\ndef closest_cuboid():\r\n    min_distance = float(\"inf\")\r\n    closest_index = -1\r\n    for i, centroid in enumerate(cuboid_centroids):\r\n        distance = ((dyn_x - centroid.X) ** 2 + (dyn_y - centroid.Y) ** 2) ** 0.5  # Euclidean distance\r\n        if distance < min_distance:\r\n            min_distance = distance\r\n            closest_index = i\r\n    return closest_index\r\n\r\nclicked_cuboid_index = closest_cuboid()\r\n\r\n# Output the detected cuboid\r\nOUT = f\"Clicked on Cuboid {clicked_cuboid_index + 1}\" if clicked_cuboid_index != -1 else \"No cuboid detected\"\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "a319607b727d44229350d5489da29ab9",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "ea8a4a3a7646456b80ebe79225973c90",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "f6f6cd3c2dd84ab3b835a520f96fbea2",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "d5f90d7b044b45bda5b9746c39e04873",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
