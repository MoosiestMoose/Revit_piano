      "InputValue": "R:\\revit\\dynamo\\WIP\\Laura\\2025\\Sound"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import winsound\r\nimport time\r\nimport os\r\n\r\nfolder_path = r\"R:\\revit\\dynamo\\WIP\\Laura\\2025\\Sound\"\r\n\r\nnotes = [\r\n    # pickupj\r\n    \"D.wav\",\r\n    # bar 1 (G): D | G . F# G B\r\n    \"G.wav\",\"FS.wav\",\"G.wav\",\"B_high.wav\",\r\n    # bar 2 (D): A . G A B\r\n    \"A_high.wav\",\"G.wav\",\"A_high.wav\",\"B_high.wav\",\r\n    # bar 3 (G): G . A B D\r\n    \"G.wav\",\"G.wav\",\"B_high.wav\",\"D_high.wav\",\r\n    # bar 4 (C): E(hold)  D\r\n    \"E_high.wav\",\"E_high.wav\" ,\r\n\r\n    # bar 5 (G): D . B B G\r\n    \"D_high.wav\",\"B_high.wav\",\"B_high.wav\",\"G.wav\",\r\n    # bar 6 (D7): A . G A B  A\r\n    \"A_high.wav\",\"G.wav\",\"A_high.wav\",\"B_high.wav\",\"A_high.wav\",\r\n    # bar 7 (E-): G . E E D\r\n    \"G.wav\",\"E.wav\",\"E.wav\",\"D.wav\",\r\n    # bar 8 (G): G(hold) D\r\n    \"G.wav\",\"E_high.wav\",\r\n\r\n    # bar 9 (G): D . B B G\r\n    \"D_high.wav\",\"B_high.wav\",\"B_high.wav\",\"G.wav\",\r\n    # bar 10 (D7): A . G A E\r\n    \"A_high.wav\",\"G.wav\",\"A_high.wav\",\"E_high.wav\",\r\n    # bar 11 (G): D . B B D\r\n    \"D_high.wav\",\"B_high.wav\",\"B_high.wav\",\"D_high.wav\",\r\n    # bar 12 (C): E(hold) D\r\n    \"E_high.wav\",\"E_high.wav\",\r\n\r\n    # bar 13 (G): D . B B G\r\n    \"D_high.wav\",\"B_high.wav\",\"B_high.wav\",\"G.wav\",\r\n    # bar 14 (D7): A . G A B  A\r\n    \"A_high.wav\",\"G.wav\",\"A_high.wav\",\"B_high.wav\",\"A_high.wav\",\r\n    # bar 15 (E-): G . E E D\r\n    \"G.wav\",\"E.wav\",\"E.wav\",\"D.wav\",\r\n    # bar 16 (G): G(hold)\r\n    \"G.wav\"\r\n]\r\n\r\nbeat = 0.22  # 1 quaver (8th note)\r\n\r\n# dotted crotchet=3, quaver=1, crotchet=2, dotted minim=6, minim=4\r\ndurations = [\r\n    # pickup\r\n    beat*2,\r\n    # bar 1 (3,1,2,2)\r\n    beat*3, beat*1, beat*2, beat*2,\r\n    # bar 2 (3,1,2,2)\r\n    beat*3, beat*1, beat*2, beat*2,\r\n    # bar 3 (3,1,2,2)\r\n    beat*3, beat*1, beat*2, beat*2,\r\n    # bar 4 (6,2)\r\n    beat*6, beat*2,\r\n\r\n    # bar 5 (3,1,2,2)\r\n    beat*3, beat*1, beat*2, beat*2,\r\n    # bar 6 (3,1,2,1,1)\r\n    beat*3, beat*1, beat*2, beat*1, beat*1,\r\n    # bar 7 (3,1,2,2)\r\n    beat*3, beat*1, beat*2, beat*2,\r\n    # bar 8 (6,2)\r\n    beat*6, beat*2,\r\n\r\n    # bar 9 (3,1,2,2)\r\n    beat*3, beat*1, beat*2, beat*2,\r\n    # bar 10 (3,1,2,2)\r\n    beat*3, beat*1, beat*2, beat*2,\r\n    # bar 11 (3,1,2,2)\r\n    beat*3, beat*1, beat*2, beat*2,\r\n    # bar 12 (6,2)\r\n    beat*6, beat*2,\r\n\r\n    # bar 13 (3,1,2,2)\r\n    beat*3, beat*1, beat*2, beat*2,\r\n    # bar 14 (3,1,2,1,1)\r\n    beat*3, beat*1, beat*2, beat*1, beat*1,\r\n    # bar 15 (3,1,2,2)\r\n    beat*3, beat*1, beat*2, beat*2,\r\n    # bar 16 (8)\r\n    beat*8\r\n]\r\n\r\n# Safety check\r\nif len(notes) != len(durations):\r\n    OUT = \"ERROR: notes ({}) and durations ({}) length mismatch\".format(len(notes), len(durations))\r\nelse:\r\n    for note, dur in zip(notes, durations):\r\n        wav_file = os.path.join(folder_path, note)\r\n\r\n        # Play asynchronously so we can control duration\r\n        winsound.PlaySound(wav_file, winsound.SND_FILENAME | winsound.SND_ASYNC)\r\n\r\n        time.sleep(dur)\r\n\r\n        # Stop the current sound before next note (prevents overlap tails)\r\n        #winsound.PlaySound(None, winsound.SND_PURGE)\r\n\r\n    OUT = \"Played (full): \" + \", \".join(notes)\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "ba9a5d70b33946d38ce799c6630e292c",
      "NodeType": "PythonScriptNode",
      "Inputs": [
