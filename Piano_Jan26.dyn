    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import winsound\r\nimport time\r\nimport os\r\n\r\nr\"ENTER THE FOLDER WHERE YOU HAVE SAVED YOUR WAV FILES\"\r\n\r\nnote = IN[0] \r\n\r\nwav_file = os.path.join(folder_path, note)\r\n\r\nif os.path.exists(wav_file):\r\n    winsound.PlaySound(\r\n        wav_file,\r\n        winsound.SND_FILENAME | winsound.SND_ASYNC\r\n    )\r\n    OUT = \"Played: \" + wav_file\r\nelse:\r\n    OUT = \"Lots of moose\"\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "abc471be4ebd49a7a61d19b4defb7e3b",
      "NodeType": "PythonScriptNode",
      "Inputs": [
