    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import os\r\n\r\nplayed = IN[0]\r\nDynoKeys = IN[1]\r\n\r\nnote = os.path.splitext(played)[0]\r\n\r\nnotes = [\r\n    # White keys\r\n    \"A\", \"B\", \"C\", \"D\", \"E\", \"F\", \"G\",\r\n    \"A_high\", \"B_high\", \"C_high\", \"D_high\", \"E_high\", \"F_high\", \"G_high\",\r\n\r\n    # Black keys\r\n    \"AS\", \"CS\", \"DS\", \"FS\", \"GS\",\r\n    \"AS_high\", \"CS_high\", \"DS_high\", \"FS_high\"\r\n]\r\n\r\nindex = notes.index(note) if note in notes else \"moose\"\r\n\r\nOUT = DynoKeys[index]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "cb017b2634aa43d5926784b29308b76e",
      "NodeType": "PythonScriptNode",
