      "Code": "import clr\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.Exceptions import OperationCanceledException\r\nclr.AddReference(\"RevitAPIUI\")\r\nfrom Autodesk.Revit.UI.Selection import ObjectType\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\ndoc   = DocumentManager.Instance.CurrentDBDocument\r\nuidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\r\nsel   = uidoc.Selection\r\n\r\n# One click pick. ESC not required\r\ntry:\r\n    r = sel.PickObject(ObjectType.Element, \"Pick one element\")\r\n    el = doc.GetElement(r.ElementId)\r\n    OUT = el.ToDSType(True) if el else \"moose\"\r\nexcept OperationCanceledException:\r\n    OUT = \"moose\"\r\nexcept:\r\n    OUT = \"moose\"\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "541de2c12fd74f08981c39621524ab46",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "32251d19481c4d2fa836b129b0e4598b",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "8ea83c64ebd748d1b80415796e99e45b",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
